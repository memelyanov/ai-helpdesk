# Copy this file to .env and fill in real values where needed.
# .env is git-ignored; this file is committed and MUST contain no real secret.

# --- Database (local development defaults; change if you like, nothing here is a real secret) ---
POSTGRES_DB=aihelpdesk
POSTGRES_USER=aihelpdesk
POSTGRES_PASSWORD=aihelpdesk

# --- Azure OpenAI (optional — the scaffold starts, serves and tests green without these) ---
# Variable names are fixed by constitution v1.3.0 and MUST NOT be renamed.
AZURE_OPEN_AI_KEY=
AZURE_OPEN_AI_ENDPOINT=
AZURE_OPEN_AI_DEPLOYMENT_NAME=
AZURE_OPEN_AI_EMBEDDING_DEPLOYMENT_NAME=
